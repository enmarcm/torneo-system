generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  /// Administrador general: hace todo y es el único que administra usuarios.
  ADMIN
  /// Community manager: publicidad e imágenes de categorías, competiciones y equipos.
  COMMUNITY_MANAGER
  /// Anotador: resultados de los partidos (iniciar, cargar eventos, finalizar).
  SCOREKEEPER
  /// Delegado de un club.
  TEAM_LEADER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum EditionStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum CompetitionFormat {
  LEAGUE
  GROUPS_KNOCKOUT
}

/// Tipo de torneo. Determina si la competición forma parte del sistema de liga
/// (con ascenso/descenso entre divisiones) o si es un torneo independiente.
enum CompetitionKind {
  LEAGUE_DIVISION // Primera / Segunda / Tercera — ligadas entre sí
  CUP // Copa de la Liga — se nutre de las divisiones
  YOUTH // Sub-12, Sub-15, Sub-17… cada una es un torneo aparte
  SPECIAL // Gremial, Veterano — torneos independientes
}

/// Decisión del administrador al cerrar la edición para cada equipo inscrito.
enum RegistrationOutcome {
  NONE
  PROMOTED
  RELEGATED
  WITHDRAWN // no participa en la próxima edición
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum MatchStage {
  LEAGUE
  GROUP
  R16
  QUARTER
  SEMI
  THIRD
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

enum MatchEventType {
  GOAL
  YELLOW
  RED
  SUB
  OTHER
}

enum DocumentType {
  CEDULA
  PARTIDA
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Dónde se muestra un anuncio. Cada valor es una ranura concreta del sitio
/// público, con su propio formato: los banners son piezas anchas dentro de un
/// panel y FOOTER_LOGOS es la tira de logos del pie, sin fondo y todos al mismo alto.
enum AdPlacement {
  HOME_BANNER // franja ancha arriba de la portada
  HOME_INLINE // entre secciones de la portada
  SIDEBAR // columna lateral
  FOOTER // panel dentro del pie de página
  FOOTER_LOGOS // tira de logos del pie, sin fondo
  MATCH_LIST // listado de partidos del calendario
  MATCH_DETAIL // ficha de un partido
  STANDINGS // tabla de posiciones
  LIVE // pantalla de partidos en vivo
  STATS // estadísticas y goleadores
  TEAMS // listado de equipos
}

/// Qué es una publicación del sitio. Una noticia se escribe entera a mano; las
/// fichas técnicas se arman solas con los números de la entidad y el redactor
/// solo les pone titular, foto y texto.
enum ArticleKind {
  NEWS
  EDITION_SHEET
  COMPETITION_SHEET
  TEAM_SHEET
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String       @id @default(uuid())
  /// Con lo que se entra al sistema. El administrador crea al delegado con un
  /// usuario corto y una contraseña; el correo lo carga el propio delegado
  /// después, si quiere, así que no puede ser la credencial de acceso.
  username     String       @unique
  email        String?      @unique
  passwordHash String
  role         UserRole     @default(TEAM_LEADER)
  status       EntityStatus @default(ACTIVE)
  team         Team?        @relation("TeamLeader", fields: [teamId], references: [id])
  teamId       String?      @unique
  auditLogs    AuditLog[]
  blocksIssued TeamBlock[]  @relation("BlockedBy")
  blocksLifted TeamBlock[]  @relation("LiftedBy")
  articles     Article[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Edition {
  id                  String        @id @default(uuid())
  name                String
  year                Int
  seasonNumber        Int
  status              EditionStatus @default(DRAFT)
  startDate           DateTime
  endDate             DateTime
  transfersOpen       Boolean       @default(false)
  transferWindowStart DateTime?
  transferWindowEnd   DateTime?
  competitions        Competition[]
  leagueSystems       LeagueSystem[]
  transfers           Transfer[]
  articles            Article[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

/// Agrupa las divisiones de una misma edición (Primera / Segunda / Tercera) para
/// que compartan ascenso/descenso y para que la Copa sepa de dónde salen sus equipos.
model LeagueSystem {
  id        String        @id @default(uuid())
  edition   Edition       @relation(fields: [editionId], references: [id])
  editionId String
  name      String
  divisions Competition[] @relation("SystemDivisions")
  cups      Competition[] @relation("SystemCups")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([editionId])
}

model Category {
  id                              String            @id @default(uuid())
  name                            String            @unique
  description                     String?
  imageUrl                        String?
  defaultFormat                   CompetitionFormat @default(LEAGUE)
  defaultKind                     CompetitionKind   @default(SPECIAL)
  defaultDivisionLevel            Int?
  defaultAgeMin                   Int?
  defaultAgeMax                   Int?
  defaultRequiresAdminEligibility Boolean           @default(false)
  defaultMinPlayers               Int               @default(11)
  defaultMaxPlayers               Int               @default(25)
  active                          Boolean           @default(true)
  competitions                    Competition[]
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
}

model Competition {
  id                       String             @id @default(uuid())
  edition                  Edition            @relation(fields: [editionId], references: [id])
  editionId                String
  category                 Category           @relation(fields: [categoryId], references: [id])
  categoryId               String
  name                     String
  format                   CompetitionFormat
  kind                     CompetitionKind    @default(SPECIAL)
  imageUrl                 String?
  division                 String?
  /// 1 = Primera, 2 = Segunda, 3 = Tercera. Ordena el ascenso/descenso.
  divisionLevel            Int?
  /// Sistema de liga al que pertenece esta división.
  leagueSystem             LeagueSystem?      @relation("SystemDivisions", fields: [leagueSystemId], references: [id])
  leagueSystemId           String?
  /// Para una Copa: sistema de liga del que se nutre de equipos.
  sourceLeagueSystem       LeagueSystem?      @relation("SystemCups", fields: [sourceLeagueSystemId], references: [id])
  sourceLeagueSystemId     String?
  ageMin                   Int?
  ageMax                   Int?
  requiresAdminEligibility Boolean            @default(false)
  minPlayers               Int                @default(11)
  maxPlayers               Int                @default(25)
  manualTeamSelection      Boolean            @default(false)
  /// Vueltas del todos contra todos (1 = solo ida, 2 = ida y vuelta).
  rounds                   Int                @default(1)
  /// Rondas de eliminatoria que se juegan a doble partido.
  twoLeggedStages          MatchStage[]       @default([])
  /// Plazas de ascenso/descenso que se pintan en la tabla. La decisión final es del admin.
  promotionSpots           Int                @default(0)
  relegationSpots          Int                @default(0)
  knockoutQualifiers       Int?
  numGroups                Int?
  groupSize                Int?
  qualifiersPerGroup       Int?
  status                   CompetitionStatus  @default(DRAFT)
  groups                   CompetitionGroup[]
  registrations            TeamRegistration[]
  matches                  Match[]
  ties                     KnockoutTie[]
  blocks                   TeamBlock[]
  articles                 Article[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  @@index([editionId])
  @@index([categoryId])
  @@index([leagueSystemId])
}

model CompetitionGroup {
  id            String             @id @default(uuid())
  competition   Competition        @relation(fields: [competitionId], references: [id])
  competitionId String
  name          String
  registrations TeamRegistration[]
  matches       Match[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  @@index([competitionId])
}

model Team {
  id            String             @id @default(uuid())
  name          String
  logoUrl       String?
  /// Desactivar conserva el historial y permite reincorporar al equipo en una
  /// edición futura. Eliminarlo desde administración sí lo borra en cascada.
  status        EntityStatus       @default(ACTIVE)
  leader        User?              @relation("TeamLeader")
  registrations TeamRegistration[]
  blocks        TeamBlock[]
  articles      Article[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

/// Alcance de un bloqueo: el club entero, o solo una de sus inscripciones.
/// Un club puede tener equipos en varias categorías a la vez, por eso se puede
/// sancionar una competición sin afectar las demás.
enum TeamBlockScope {
  CLUB // bloqueo total: el líder no puede iniciar sesión
  COMPETITION // solo queda fuera de esa competición
}

/// Historial de bloqueos y sanciones. No se borra al levantar el bloqueo:
/// queda el registro de por qué se bloqueó y quién lo levantó.
model TeamBlock {
  id            String         @id @default(uuid())
  team          Team           @relation(fields: [teamId], references: [id])
  teamId        String
  scope         TeamBlockScope @default(CLUB)
  competition   Competition?   @relation(fields: [competitionId], references: [id])
  competitionId String?
  reason        String
  active        Boolean        @default(true)
  blockedBy     User?          @relation("BlockedBy", fields: [blockedById], references: [id])
  blockedById   String?
  liftedBy      User?          @relation("LiftedBy", fields: [liftedById], references: [id])
  liftedById    String?
  liftedAt      DateTime?
  liftReason    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([teamId])
  @@index([competitionId])
  @@index([active])
}

model TeamRegistration {
  id            String            @id @default(uuid())
  team          Team              @relation(fields: [teamId], references: [id])
  teamId        String
  competition   Competition       @relation(fields: [competitionId], references: [id])
  competitionId String
  group         CompetitionGroup? @relation(fields: [groupId], references: [id])
  groupId       String?
  status        EntityStatus      @default(ACTIVE)
  /// Ascenso / descenso / no participa. Lo decide el administrador, no la tabla.
  outcome       RegistrationOutcome @default(NONE)
  outcomeNote   String?
  roster        RosterEntry[]
  homeMatches   Match[]           @relation("HomeRegistration")
  awayMatches   Match[]           @relation("AwayRegistration")
  matchEvents   MatchEvent[]
  tiesAsHome    KnockoutTie[]     @relation("TieHome")
  tiesAsAway    KnockoutTie[]     @relation("TieAway")
  tiesWon       KnockoutTie[]     @relation("TieWinner")
  transfersFrom Transfer[]        @relation("TransferFrom")
  transfersTo   Transfer[]        @relation("TransferTo")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  @@unique([teamId, competitionId])
  @@index([competitionId])
}

/// Una llave del cuadro de eliminatoria. Agrupa 1 partido (único) o 2 (ida y vuelta)
/// y apunta a la llave siguiente para que el ganador avance solo.
model KnockoutTie {
  id                   String            @id @default(uuid())
  competition          Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionId        String
  stage                MatchStage
  /// Posición dentro de la ronda (0-based), define el orden del cuadro.
  slot                 Int
  twoLegged            Boolean           @default(false)
  homeRegistration     TeamRegistration? @relation("TieHome", fields: [homeRegistrationId], references: [id])
  homeRegistrationId   String?
  awayRegistration     TeamRegistration? @relation("TieAway", fields: [awayRegistrationId], references: [id])
  awayRegistrationId   String?
  winnerRegistration   TeamRegistration? @relation("TieWinner", fields: [winnerRegistrationId], references: [id])
  winnerRegistrationId String?
  /// Llave a la que avanza el ganador.
  nextTie              KnockoutTie?      @relation("TieProgression", fields: [nextTieId], references: [id])
  nextTieId            String?
  /// Si el ganador entra como local en la llave siguiente.
  nextSlotIsHome       Boolean           @default(true)
  previousTies         KnockoutTie[]     @relation("TieProgression")
  matches              Match[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  @@unique([competitionId, stage, slot])
  @@index([competitionId])
}

model Player {
  id                       String        @id @default(uuid())
  documentType             DocumentType
  documentNumber           String
  firstName                String
  lastName                 String
  birthDate                DateTime
  position                 String?
  photoUrl                 String?
  universityDegreeVerified Boolean       @default(false)
  degreeDocUrl             String?
  status                   EntityStatus  @default(ACTIVE)
  rosterEntries            RosterEntry[]
  matchEvents              MatchEvent[]
  mvpMatches               Match[]       @relation("MatchMvp")
  transfers                Transfer[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  @@unique([documentType, documentNumber])
}

model RosterEntry {
  id                  String             @id @default(uuid())
  player              Player             @relation(fields: [playerId], references: [id])
  playerId            String
  teamRegistration    TeamRegistration   @relation(fields: [teamRegistrationId], references: [id])
  teamRegistrationId  String
  jerseyNumber        Int?
  eligibilityApproved Boolean            @default(false)
  status              EntityStatus       @default(ACTIVE)
  stats               PlayerSeasonStats?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  @@unique([playerId, teamRegistrationId])
  @@index([teamRegistrationId])
}

model PlayerSeasonStats {
  id            String      @id @default(uuid())
  rosterEntry   RosterEntry @relation(fields: [rosterEntryId], references: [id])
  rosterEntryId String      @unique
  matchesPlayed Int         @default(0)
  goals         Int         @default(0)
  assists       Int         @default(0)
  yellowCards   Int         @default(0)
  redCards      Int         @default(0)
  minutesPlayed Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Match {
  id                 String            @id @default(uuid())
  competition        Competition       @relation(fields: [competitionId], references: [id])
  competitionId      String
  group              CompetitionGroup? @relation(fields: [groupId], references: [id])
  groupId            String?
  stage              MatchStage        @default(LEAGUE)
  matchday           Int               @default(1)
  tie                KnockoutTie?      @relation(fields: [tieId], references: [id], onDelete: Cascade)
  tieId              String?
  /// 1 = ida, 2 = vuelta. Null en partido único o de liga.
  leg                Int?
  homeRegistration   TeamRegistration  @relation("HomeRegistration", fields: [homeRegistrationId], references: [id])
  homeRegistrationId String
  awayRegistration   TeamRegistration  @relation("AwayRegistration", fields: [awayRegistrationId], references: [id])
  awayRegistrationId String
  /// Null hasta que el admin le asigna día y hora. El sorteo genera solo los cruces.
  scheduledAt        DateTime?
  /// Partido destacado de la jornada. Lo marca el admin al programarlo y es lo
  /// que la portada muestra como "lo que viene" antes que el resto del fixture.
  featured           Boolean           @default(false)
  status             MatchStatus       @default(SCHEDULED)
  homeScore          Int               @default(0)
  awayScore          Int               @default(0)
  venue              String?
  mvpPlayer          Player?           @relation("MatchMvp", fields: [mvpPlayerId], references: [id])
  mvpPlayerId        String?
  mvpPhotoUrl        String?
  mvpNote            String?
  events             MatchEvent[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  @@index([competitionId])
  @@index([status])
  @@index([tieId])
}

model MatchEvent {
  id                 String           @id @default(uuid())
  match              Match            @relation(fields: [matchId], references: [id])
  matchId            String
  player             Player?          @relation(fields: [playerId], references: [id])
  playerId           String?
  teamRegistration   TeamRegistration @relation(fields: [teamRegistrationId], references: [id])
  teamRegistrationId String
  type               MatchEventType
  minute             Int
  createdAt          DateTime         @default(now())
  @@index([matchId])
}

model Transfer {
  id                 String            @id @default(uuid())
  player             Player            @relation(fields: [playerId], references: [id])
  playerId           String
  edition            Edition           @relation(fields: [editionId], references: [id])
  editionId          String
  fromRegistration   TeamRegistration? @relation("TransferFrom", fields: [fromRegistrationId], references: [id])
  fromRegistrationId String?
  toRegistration     TeamRegistration  @relation("TransferTo", fields: [toRegistrationId], references: [id])
  toRegistrationId   String
  status             TransferStatus    @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  @@index([editionId])
}

model Advertisement {
  id         String        @id @default(uuid())
  /// Nombre interno del anuncio: es lo que el administrador lee en el panel.
  title      String        @default("")
  imageUrl   String
  linkUrl    String?
  /// Un mismo anuncio puede ocupar varias ranuras a la vez.
  placements AdPlacement[] @default([])
  sortOrder  Int           @default(0)
  active     Boolean       @default(true)
  /// Ventana de publicación. Vacías = se muestra siempre que esté activo.
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

/// Una publicación del apartado de noticias. Las fichas técnicas guardan sus
/// números en `snapshot`: una vez publicada, la ficha no puede cambiar sola
/// porque el torneo siga jugándose — se regenera a mano cuando el redactor quiere.
model Article {
  id            String        @id @default(uuid())
  kind          ArticleKind   @default(NEWS)
  status        ArticleStatus @default(DRAFT)
  title         String
  /// Lo que va en la URL pública. Se arma del titular y no cambia al editarlo,
  /// para no romper los enlaces que ya se compartieron.
  slug          String        @unique
  summary       String?
  body          String        @default("")
  coverUrl      String?
  /// Portada del apartado: se muestra grande arriba del listado.
  featured      Boolean       @default(false)
  publishedAt   DateTime?
  /// De qué habla la ficha. Se pone en null si se borra la entidad: la nota
  /// publicada sobrevive con sus números congelados.
  edition       Edition?      @relation(fields: [editionId], references: [id], onDelete: SetNull)
  editionId     String?
  competition   Competition?  @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  competitionId String?
  team          Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId        String?
  /// Año al que se acota la ficha de un equipo. Vacío = toda su historia.
  year          Int?
  /// Números de la ficha, congelados al generarla.
  snapshot      Json?
  snapshotAt    DateTime?
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([kind])
  @@index([editionId])
  @@index([teamId])
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([entity])
}
